# Variables de entorno para Paneles Solares Backend
# Copia este archivo a .env y rellena con tus credenciales reales

# 🚀 SERVIDOR
PORT=3000
NODE_ENV=production

# 📧 SENDGRID (para enviar emails)
# Obtén tu API key en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@paneles-solares.com

# 💬 TWILIO (para enviar WhatsApp)
# Obtén tus credenciales en: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE=whatsapp:+14155552671

# 👨‍💼 ADMIN
ADMIN_EMAIL=joseolivo78376@gmail.com
